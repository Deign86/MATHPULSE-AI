#!/usr/bin/env sh
# Git pre-commit hook: enforces anti-slop Oxlint rules and unlazy gates
echo "?? Running Oxlint anti-slop checks..."
npx oxlint --quiet
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
  echo "? Anti-slop checks failed! Fix the violations above before committing."
  exit $EXIT_CODE
fi
echo "? Anti-slop checks passed."

if [ -f "GATES.md" ]; then
  echo "?? Verifying unlazy acceptance gates in GATES.md..."
  node .agents/skills/unlazy/scripts/gate-check.mjs GATES.md
  GATE_EXIT=$?
  if [ $GATE_EXIT -ne 0 ]; then
    echo "? Unlazy acceptance gates not met! Complete all gates before committing."
    exit $GATE_EXIT
  fi
  echo "? Unlazy acceptance gates verified."
fi