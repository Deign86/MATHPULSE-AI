rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /curriculum/{allPaths=**} {
      allow read: if true;
    }
    match /profile-pictures/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
